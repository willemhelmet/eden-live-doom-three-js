{
  "name": "eden-live-doom-three-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Doom on a Steam Deck, restyled live by Reactor EdenLive.",
  "license": "GPL-2.0-only",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "dev": "node server.mjs --dev",
