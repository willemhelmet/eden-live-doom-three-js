    "test:browser": "playwright test",
    "deck": "bash scripts/deck.sh"
  },
  "dependencies": {
    "@reactor-models/eden-live": "2.1.3",
    "@reactor-team/js-sdk": "3.3.0",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
